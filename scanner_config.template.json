{
  "target_url": "https://github.com/YOUR_ORGANIZATION_OR_USERNAME",
  "auth_token": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_OPTIONAL",
  "scan_options": {
    "include_forks": false,
    "include_archived": true,
    "max_repos": 100,
    "offline_fixture": ""
  },
  "clustering_rules": [
    {
      "pattern": ".*-medical|.*-health|.*-patient",
      "cluster_id": "medical-healthcare",
      "name": "Medical & Healthcare",
      "description": "Clinical applications, patient management, and healthcare data."
    },
    {
      "pattern": ".*-genomics|.*-bio|.*-dna",
      "cluster_id": "life-sciences-bio",
      "name": "Life Sciences & Bioinformatics",
      "description": "Biological data analysis and genomics sequencing."
    },
    {
      "pattern": ".*-billing|.*-payment",
      "cluster_id": "finance-billing",
      "name": "Finance & Billing",
      "description": "Payment processing and financial management."
    }
  ],
  "output": {
    "output_dir": "output",
    "generate_dashboard": true,
    "generate_markdown": true,
    "generate_json": true
  }
}
